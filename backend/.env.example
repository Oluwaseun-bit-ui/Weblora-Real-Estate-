# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=development

# Database
DATABASE_URL=postgres://realestate:realestate@localhost:5432/realestate
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=realestate
DB_HOST=localhost
DB_PORT=5432

# CORS / Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object storage (images) - S3-compatible (AWS S3, DigitalOcean Spaces, Cloudflare R2, etc.)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Maps (configurable provider)
MAP_PROVIDER=maplibre
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Regulatory verification providers (Phase 2) ---
# ESVARBON has no public API as of this writing; verification is a manual
# workflow with evidence links stored against the official portal below.
ESVARBON_VERIFY_URL=https://portal.esvarbon.gov.ng/pages/verify
ESVARBON_REGISTER_URL=https://www.esvarbon.gov.ng/register-of-esvs/

# LASRERA has no confirmed public API; manual workflow only until one exists.
LASRERA_INFO_URL=https://lasrera.lagosstate.gov.ng/

# CAC public search (manual workflow unless/until an authorized API is wired up)
CAC_PUBLIC_SEARCH_URL=https://search.cac.gov.ng/

# --- Live viewing (real-time video) provider ---
# One of: livekit | agora | daily | twilio | none
LIVE_VIEWING_PROVIDER=none
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Email (initial notification channel)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Timezone
TIME_ZONE=Africa/Lagos

# Web search (Option A) -- get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
